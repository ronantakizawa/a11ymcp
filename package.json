{
  "name": "a11y-mcp-server",
  "version": "1.1.0",
  "description": "An MCP server for accessibility testing using Axe-core",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "bin": {
    "a11y-mcp-server": "dist/index.js"
  },
  "access": "public",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "test": "tsx --test test/**/*.test.ts",
    "prepare": "npm run build",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "axe",
    "axe-core",
    "mcp",
    "wcag",
    "claude",
    "ai"
  ],
  "author": "Ronan Takizawa",
  "license": "MIT",
  "dependencies": {
    "@axe-core/puppeteer": "4.11.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "accessibility-checker": "4.0.31",
    "axe-core": "4.11.4",
    "puppeteer": "25.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "shx": "^0.3.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronantakizawa/a11ymcp.git"
  },
  "bugs": {
    "url": "https://github.com/ronantakizawa/a11ymcp/issues"
  },
  "homepage": "https://github.com/ronantakizawa/a11ymcp#readme"
}
